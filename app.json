{
  "expo": {
    "name": "Pocket Ahead",
    "slug": "pocket-ahead",
    "description": "Private, multilingual personal finance planning and expense tracking.",
    "platforms": [
      "android",
      "web"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "scheme": "pocketahead",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.kaellabs.pocketahead",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1858EB",
        "foregroundImage": "./assets/branding/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-pocket-ahead-colors",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8FC",
          "image": "./assets/branding/splash-logo.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pocket Ahead accesses your photos only when you choose a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.423722813251-ihpjde9unp70mlreq07164fubo9qcku1"
        }
      ],
      "expo-image",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d42a523f-da91-46c1-8499-152d1912bd67"
      }
    }
  }
}

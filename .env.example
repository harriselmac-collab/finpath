# Stitch / Google Wallet Configuration
# IMPORTANT: Keep sensitive values server-side. Only EXPO_PUBLIC_ vars are safe in the client bundle.

# Required for production authentication and synchronization
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Development only. Production builds ignore this flag.
EXPO_PUBLIC_ENABLE_AUTH_SIMULATION=false
EXPO_PUBLIC_SUPPORT_EMAIL=

# Your Stitch issuer ID (format: 33880000000000000000)
EXPO_PUBLIC_STITCH_ISSUER_ID=

# Service account origin JWT for Google Wallet API (server-side only)
STITCH_ORIGIN_JWT=

# MCP server URL (development only - do not expose API keys in client)
EXPO_PUBLIC_STITCH_MCP_URL=

# MCP API Key (development only)
STITCH_MCP_API_KEY=

# Pass class IDs imported from Stitch console
EXPO_PUBLIC_STITCH_SAVINGS_GOAL_CLASS=
EXPO_PUBLIC_STITCH_DEBT_MILESTONE_CLASS=
EXPO_PUBLIC_STITCH_EMERGENCY_FUND_CLASS=
